# Sanchay Environment Configuration Example
# Copy to .env or .env.local

# Data mode: 'mock' (standalone in-memory) or 'firebase' (Firebase Firestore/Auth)
VITE_DATA=mock

# Emulator toggle: Set to 'true' to connect to local Firebase Emulators
VITE_USE_EMULATOR=true

# Firebase Web App Config (Required when VITE_DATA=firebase)
# For local emulators, you can keep the demo values below.
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=demo-sanchay.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sanchay
VITE_FIREBASE_STORAGE_BUCKET=demo-sanchay.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Emulator Ports (Defaults: Auth=9099, Firestore=8080, Functions=5001)
VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_FUNCTIONS_HOST=127.0.0.1
VITE_EMULATOR_FUNCTIONS_PORT=5001
VITE_FUNCTIONS_REGION=asia-south1
