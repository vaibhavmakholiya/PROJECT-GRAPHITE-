[debug] [2026-10-28T02:48:10.440Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-sanchay:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function inSameGroup(groupId) {\n      return isAuthenticated() && ('groupId' in request.auth.token) && request.auth.token.groupId == groupId;\n    }\n\n    function isAdmin(groupId) {\n      return (isAuthenticated() && ('role' in request.auth.token) && request.auth.token.role == 'admin' && (!('groupId' in request.auth.token) || request.auth.token.groupId == groupId))\n        || (isAuthenticated() && (\n             ('phone_number' in request.auth.token && (request.auth.token.phone_number == '+919876543210' || request.auth.token.phone_number == '+919800000001'))\n             || ('phone' in request.auth.token && (request.auth.token.phone == '+919876543210' || request.auth.token.phone == '+919800000001'))\n           ));\n    }\n\n    function isMember(groupId) {\n      return inSameGroup(groupId) && ('role' in request.auth.token) && request.auth.token.role == 'member';\n    }\n\n    function isOwner(groupId, memberId) {\n      return inSameGroup(groupId) && ('memberId' in request.auth.token) && request.auth.token.memberId == memberId;\n    }\n\n    function isPositiveInteger(num) {\n      return num is int && num > 0;\n    }\n\n    function doesNotContainRawAadhaar(data) {\n      return !('aadhaar' in data) && !('aadhaarNumber' in data);\n    }\n\n    // Top-level fast lookup index for registration: groupCode -> groupId\n    match /groupCodeIndex/{groupCode} {\n      allow read: if true;\n      allow write: if isAuthenticated();\n    }\n\n    // Rules for multi-tenant groups\n    match /groups/{groupId} {\n      // Group root doc: readable by all members/admins in the group\n      allow read: if inSameGroup(groupId) || isAdmin(groupId);\n      allow write: if isAdmin(groupId);\n\n      // Group settings: readable by all members of the group, writable only by admin\n      match /settings/{settingId} {\n        allow read: if inSameGroup(groupId) || isAdmin(groupId);\n        allow write: if isAdmin(groupId);\n      }\n\n      // Members collection\n      match /members/{memberId} {\n        // Members can read their own profile; Admin can read all members;\n        // Pending members can read their own profile before custom claims are set\n        allow read: if isOwner(groupId, memberId)\n                    || isAdmin(groupId)\n                    || (isAuthenticated() && (\n                        (resource.data.authUid == request.auth.uid)\n                        || ('phone_number' in request.auth.token && (\n                            resource.data.phone == request.auth.token.phone_number\n                            || ('+91' + resource.data.phone) == request.auth.token.phone_number\n                           ))\n                        || ('phone' in request.auth.token && (\n                            resource.data.phone == request.auth.token.phone\n                            || ('+91' + resource.data.phone) == request.auth.token.phone\n                           ))\n                       ));\n\n        // Allow member to create or update their own profile document (authUid matches request.auth.uid, or verified phone matches)\n        // or admin to write, strictly ensuring raw Aadhaar is never saved\n        allow create: if (isAdmin(groupId) || (isAuthenticated() && (\n                            request.resource.data.authUid == request.auth.uid\n                            || ('phone_number' in request.auth.token && (\n                                request.resource.data.phone == request.auth.token.phone_number\n                                || ('+91' + request.resource.data.phone) == request.auth.token.phone_number\n                               ))\n                            || ('phone' in request.auth.token && (\n                                request.resource.data.phone == request.auth.token.phone\n                                || ('+91' + request.resource.data.phone) == request.auth.token.phone\n                               ))\n                         )))\n                      && doesNotContainRawAadhaar(request.resource.data);\n\n        allow update: if (isAdmin(groupId) || (isAuthenticated() && (\n                            resource.data.authUid == request.auth.uid\n                            || request.resource.data.authUid == request.auth.uid\n                            || ('phone_number' in request.auth.token && (\n                                resource.data.phone == request.auth.token.phone_number\n                                || request.resource.data.phone == request.auth.token.phone_number\n                                || ('+91' + resource.data.phone) == request.auth.token.phone_number\n                                || ('+91' + request.resource.data.phone) == request.auth.token.phone_number\n                               ))\n                            || ('phone' in request.auth.token && (\n                                resource.data.phone == request.auth.token.phone\n                                || request.resource.data.phone == request.auth.token.phone\n                                || ('+91' + resource.data.phone) == request.auth.token.phone\n                                || ('+91' + request.resource.data.phone) == request.auth.token.phone\n                               ))\n                         )))\n                      && doesNotContainRawAadhaar(request.resource.data);\n\n        allow delete: if isAdmin(groupId);\n      }\n\n      // Transactions: Strictly APPEND-ONLY! Updates and deletes are ALWAYS prohibited.\n      match /transactions/{txId} {\n        // Members read only their own transactions; Admin reads all\n        allow read: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                    || isAdmin(groupId);\n\n        // Created by admin. Updates and deletes ALWAYS prohibited.\n        allow create: if isAdmin(groupId)\n          && request.resource.data.txId == txId\n          && request.resource.data.groupId == groupId\n          && isPositiveInteger(request.resource.data.amountPaise)\n          && request.resource.data.type in ['contribution', 'withdrawal', 'loan_disbursement', 'loan_repayment', 'reversal']\n          && request.resource.data.mode in ['cash', 'upi', 'bank']\n          && doesNotContainRawAadhaar(request.resource.data)\n          && (\n            request.resource.data.type != 'reversal' ||\n            (\n              ('reversesId' in request.resource.data) &&\n              request.resource.data.reversesId is string &&\n              request.resource.data.reversesId.size() > 0 &&\n              ('reason' in request.resource.data) &&\n              request.resource.data.reason is string &&\n              request.resource.data.reason.size() > 0\n            )\n          );\n\n        allow update, delete: if false;\n      }\n\n      // Receipts: Created in same writeBatch as transaction. APPEND-ONLY.\n      match /receipts/{receiptId} {\n        allow read: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                    || isAdmin(groupId);\n\n        // Created by admin during transaction writeBatch. Updates and deletes ALWAYS prohibited.\n        allow create: if isAdmin(groupId)\n          && request.resource.data.receiptId == receiptId\n          && request.resource.data.groupId == groupId\n          && request.resource.data.status == 'APPROVED'\n          && isPositiveInteger(request.resource.data.amountPaise)\n          && doesNotContainRawAadhaar(request.resource.data);\n\n        allow update, delete: if false;\n      }\n\n      // Loan Requests: Members create only for themselves with status \"pending\"\n      match /loanRequests/{requestId} {\n        allow read: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                    || isAdmin(groupId);\n\n        allow create: if (isMember(groupId) || isAdmin(groupId))\n          && ('memberId' in request.auth.token)\n          && request.resource.data.memberId == request.auth.token.memberId\n          && request.resource.data.groupId == groupId\n          && request.resource.data.status == 'pending'\n          && isPositiveInteger(request.resource.data.amountPaise)\n          && isPositiveInteger(request.resource.data.installments);\n\n        // Only admin can decide / update status of loan requests\n        allow update: if isAdmin(groupId);\n        allow delete: if false;\n      }\n\n      // Loans & Schedule: Members read only their own loans; writable only by admin / backend\n      match /loans/{loanId} {\n        allow read: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                    || isAdmin(groupId);\n        allow write: if isAdmin(groupId);\n\n        match /schedule/{installmentNum} {\n          allow read: if (isAuthenticated() && inSameGroup(groupId) && ('memberId' in request.auth.token) && get(/databases/$(database)/documents/groups/$(groupId)/loans/$(loanId)).data.memberId == request.auth.token.memberId)\n                      || isAdmin(groupId);\n          allow write: if isAdmin(groupId);\n        }\n      }\n\n      // Announcements: Readable by any group member; writable only by admin\n      match /announcements/{announcementId} {\n        allow read: if inSameGroup(groupId);\n        allow write: if isAdmin(groupId);\n      }\n\n      // Notifications: Members read and mark read only their own notifications\n      match /notifications/{notificationId} {\n        allow read: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                    || isAdmin(groupId);\n        // Member can update 'read' status on their own notification\n        allow update: if (isAuthenticated() && ('memberId' in request.auth.token) && resource.data.memberId == request.auth.token.memberId && inSameGroup(groupId))\n                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\n        allow create, delete: if isAdmin(groupId);\n      }\n\n      // Conflicts: Admin only\n      match /conflicts/{conflictId} {\n        allow read, write: if isAdmin(groupId);\n      }\n\n      // Device Tokens for FCM: Read/write by owner member or admin\n      match /deviceTokens/{memberId} {\n        allow read, write: if isOwner(groupId, memberId) || isAdmin(groupId);\n      }\n\n      // Group Config collection (e.g. config/settings)\n      match /config/{configId} {\n        allow read: if inSameGroup(groupId) || isAdmin(groupId);\n        allow write: if isAdmin(groupId);\n      }\n\n      // Aadhaar Index: O(1) duplicate prevention - Backend / Cloud Functions only\n      match /aadhaarIndex/{hash} {\n        allow read, write: if false;\n      }\n\n      // Audit Log: Immutable audit trail - Backend / Cloud Functions only\n      match /auditLog/{auditId} {\n        allow read, write: if false;\n      }\n    }\n  }\n}\n"}]}}
